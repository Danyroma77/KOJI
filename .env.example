# === KOJI — Configurazione ===
# Copiare in .env e personalizzare

# Dataset attivo
KOJI_DATASET_NAME=default

# Chunking
# Strategia di suddivisione: paragraph | section | sentence | fixed | page
# paragraph = paragrafi (default)
# section = sezioni Markdown (titoli H1-H6)
# sentence = frasi complete
# fixed = finestra rigida di caratteri
# page = una pagina del documento originale (solo PDF)
KOJI_CHUNK_STRATEGY=paragraph
KOJI_CHUNK_SIZE=512
KOJI_CHUNK_OVERLAP_PCT=20

# Embedding
KOJI_EMBEDDING_MODEL=all-MiniLM-L6-v2
KOJI_EMBEDDING_BATCH_SIZE=32
# Timeout (secondi) embedding di una query: oltre il limite errore esplicito
KOJI_EMBEDDING_TIMEOUT=30

# Vector Store
KOJI_HNSW_M=16
KOJI_HNSW_EF_CONSTRUCTION=200

# RAG
KOJI_RAG_TOP_K_DENSE=10
KOJI_RAG_TOP_K_KEYWORD=10
KOJI_RAG_TOP_K_FINAL=5
KOJI_RAG_RRF_K=60
# Candidati su cui applicare il cross-encoder di re-ranking
KOJI_RAG_RERANK_TOP_K=20
# Abilita/disabilita il re-ranking (BE-RF-15)
KOJI_RAG_RERANK_ENABLED=true
# Modalità di retrieval di default: hybrid | dense | bm25
KOJI_RAG_RETRIEVAL_MODE=hybrid
KOJI_RAG_TEMPERATURE=0.3
KOJI_RAG_MAX_TOKENS=1024

# Upload documenti (dimensione massima in MB)
KOJI_MAX_UPLOAD_SIZE_MB=200

# LLM
KOJI_OLLAMA_BASE_URL=http://localhost:11434
KOJI_OLLAMA_MODEL=phi3:3.8b
KOJI_OLLAMA_TIMEOUT=120

# Catalogo dei modelli messi a disposizione nella pagina Modelli
# (lista JSON). Tutti in quantizzazione Q4_K_M.
KOJI_AVAILABLE_MODELS=["llama3.2:3b","mistral:7b","qwen2.5:3b","gemma2:2b","phi3:3.8b"]

# Knowledge Graph
KOJI_GRAPH_CONFIDENCE_THRESHOLD=0.7
# Le entità del grafo devono comparire testualmente nel documento (grounding):
# le triple con entità non presenti nel testo vengono scartate
KOJI_GRAPH_REQUIRE_GROUNDING=true
# Lunghezza massima dell'etichetta di un'entità (caratteri)
KOJI_GRAPH_MAX_ENTITY_CHARS=60

# Monitoraggio
KOJI_METRICS_INTERVAL_SEC=5

# Server
KOJI_HOST=0.0.0.0
KOJI_PORT=8000
KOJI_CORS_ORIGINS=["http://localhost:3000"]