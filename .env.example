# === KnowLocal — Configurazione ===
# Copiare in .env e personalizzare

# Dataset attivo
KNOWLOCAL_DATASET_NAME=default

# Chunking
KNOWLOCAL_CHUNK_SIZE=512
KNOWLOCAL_CHUNK_OVERLAP_PCT=20

# Embedding
KNOWLOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
KNOWLOCAL_EMBEDDING_BATCH_SIZE=32

# Vector Store
KNOWLOCAL_HNSW_M=16
KNOWLOCAL_HNSW_EF_CONSTRUCTION=200

# RAG
KNOWLOCAL_RAG_TOP_K_DENSE=10
KNOWLOCAL_RAG_TOP_K_KEYWORD=10
KNOWLOCAL_RAG_TOP_K_FINAL=5
KNOWLOCAL_RAG_TEMPERATURE=0.3
KNOWLOCAL_RAG_MAX_TOKENS=1024

# LLM
KNOWLOCAL_OLLAMA_BASE_URL=http://localhost:11434
KNOWLOCAL_OLLAMA_MODEL=phi3:3.8b
KNOWLOCAL_OLLAMA_TIMEOUT=120

# Catalogo dei modelli messi a disposizione nella pagina Modelli
# (lista JSON; prefisso effettivo: KOJI_). Tutti in quantizzazione Q4_K_M.
KOJI_AVAILABLE_MODELS=["llama3.2:3b","mistral:7b","qwen2.5:3b","gemma2:2b","phi3:3.8b"]

# Knowledge Graph
KNOWLOCAL_GRAPH_CONFIDENCE_THRESHOLD=0.7

# Monitoraggio
KNOWLOCAL_METRICS_INTERVAL_SEC=5

# Server
KNOWLOCAL_HOST=0.0.0.0
KNOWLOCAL_PORT=8000
KNOWLOCAL_CORS_ORIGINS=["http://localhost:3000"]